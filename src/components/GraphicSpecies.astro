---
import PlotFigure from "./PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";

type Props = {
	species: string;
};

const { species } = Astro.props;
const penguinsSpecies = penguins.filter(
	({ species: penguinSpecies }) => penguinSpecies === species,
);
---

<h1 class="text-2xl">Penguins {species}</h1>
<PlotFigure
	options={{
		grid: true,
		x: { label: "Culmen length (mm)" },
		y: { label: "Culmen depth (mm)" },
		marks: [
			Plot.dot(penguinsSpecies, {
				x: "culmen_length_mm",
				y: "culmen_depth_mm",
				fill: "sex",
				tip: true,
			}),
		],
	}}
/>